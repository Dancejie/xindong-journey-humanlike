# Copy this file to .env.llm.local and keep the real file local only.
# Choose the process-wide default. Individual supported requests may override
# this with X-LLM-Provider: deepseek or X-LLM-Provider: dots.
LLM_PROVIDER=deepseek

# DeepSeek (kept for the existing comparison path)
DEEPSEEK_API_BASE=https://api.deepseek.com
# Uncomment and fill this only when no legacy .env.deepseek.local provides it.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Dots OpenAI-compatible Chat Completions endpoint
DOTS_API_BASE=https://note3-prev-api.askdiandian.com/v1
DOTS_API_KEY=
DOTS_MODEL=dots3-note-prev
# Keep this false for lower-latency dialogue and a cleaner provider comparison.
DOTS_ENABLE_THINKING=false

# Optional local-playtest overrides. The startup script defaults to 80/400;
# Render keeps its separate public 20/200 limits from render.yaml.
# AGENT_RATE_LIMIT=80
# AGENT_GLOBAL_RATE_LIMIT=400
